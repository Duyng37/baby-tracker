# Copy to .env.local; fill privately. Never commit real values or send them in chat.
# Public project identifier used to namespace the existing IndexedDB data.
VITE_SUPABASE_URL=

# SERVER ONLY. Never add VITE_ to any of these variables.
APP_ORIGIN=http://127.0.0.1:5173
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# 32 cryptographically random bytes encoded as 64 hex characters; use a password manager.
SESSION_ENCRYPTION_KEY=